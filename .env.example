FLASK_APP=run.py
FLASK_DEBUG=1
PORT=7014

# Persistent data dir (SQLite DB + uploaded media). Local dev defaults to
# ./instance; in Docker it is /data (a mounted volume).
DATA_DIR=instance

# Postgres connection string. When set it replaces the SQLite file under DATA_DIR —
# that's how a deploy with no persistent disk (serverless) runs. Paste the provider's
# string as-is: `postgres://` and `postgresql://` are rewritten to the psycopg driver.
# Prefer the provider's POOLED endpoint; many short-lived instances each opening
# connections is how a serverless app exhausts a Postgres connection limit.
DATABASE_URL=

# Admin panel: the single shared password used to log in at /admin.
# Set a long, private value in production (Vercel project env vars).
ADMIN_PASSWORD=changeme

# Flask session secret. If empty, a stable key is generated and persisted under
# DATA_DIR. That needs a writable, persistent DATA_DIR: where there isn't one (a
# serverless deploy), the app refuses to boot rather than mint a new key per process
# and log the admin out on every cold start. Set it explicitly there.
SECRET_KEY=

# Where processed media (product photos/videos, editor uploads) is stored.
#   local  -> the filesystem under DATA_DIR/media, served by the /media route. The
#             default: local dev, the test suite and the Docker deploy.
#   blob   -> Vercel Blob, which serves the files from its own CDN.
MEDIA_STORE=local

# Whether the app creates tables, seeds and heals media variants at boot. On by
# default, which is right for a container that boots once against a volume. Set to 0
# where a cold start happens per request (serverless) and run `flask init-db` once
# against the database instead.
AUTO_INIT_DB=1

# Set to 1 in production (HTTPS) to mark the session cookie Secure. Leave 0 for
# local http dev. SameSite=Lax + HttpOnly are always on.
SESSION_COOKIE_SECURE=0

# Public/canonical origin for OG, Twitter, canonical and sitemap URLs (no trailing
# slash). This is the single indexable domain — everything else 301s to it.
SITE_URL=https://gluckbags.com

# In production set to 1: the app 301-redirects every non-canonical host (www, the
# nexttech alias) and http -> SITE_URL, and adds HSTS. Leave 0 for local http dev.
FORCE_CANONICAL_HOST=0

# --- Tienda Nube (Nuvemshop) headless POC ------------------------------------
# See docs/TIENDANUBE-HEADLESS-POC.md and docs/TIENDANUBE-SETUP.md.
#
# OAuth app credentials (from the Partners panel when you create the app). Only
# needed to run scripts/tn_oauth.py once to obtain the token below.
TN_CLIENT_ID=
TN_CLIENT_SECRET=
#
# The API is OAuth server-to-server: after installing the app in the store, the
# OAuth exchange yields a store id + a PERMANENT access token (TN tokens don't
# expire). scripts/tn_oauth.py prints these ready to paste; scripts/tn_spike.py
# then reads them to validate the connection. Keep private (Vercel project env
# vars in prod).
TN_STORE_ID=
TN_ACCESS_TOKEN=
# API version pinned in the base URL (https://api.tiendanube.com/<version>/<store>).
TN_API_VERSION=2025-03
# REQUIRED by Tienda Nube: an identifying User-Agent that includes a contact email.
TN_USER_AGENT=GLUCK Headless POC (dev@gluckbags.com)
#
# Where the storefront + cart read products from:
#   tiendanube  -> the mirrored Tienda Nube catalogue (PRODUCTION). Cart lines carry
#                  TN ids and the checkout handoff closes the loop. Requires a synced
#                  mirror (scripts/tn_spike.py validates the token; the sync populates it).
#   admin       -> the legacy admin-managed catalogue (local dev without TN creds,
#                  and the rollback fallback).
CATALOG_SOURCE=admin

# --- Mirror sync scheduling ---------------------------------------------------
# The hourly Tienda Nube sync runs in a daemon thread inside the app process. That
# needs a process that outlives the request, so turn it off (0) where one doesn't
# exist (serverless) and drive the sync from outside instead.
TN_SYNC_ENABLED=1
# How often the in-process scheduler syncs, in seconds. Minimum 60.
TN_SYNC_INTERVAL=3600
#
# Shared secret for `GET /internal/sync-tn`, the out-of-process trigger (see
# .github/workflows/sync-tiendanube.yml). Callers send it as `Authorization: Bearer
# <value>`. While it is EMPTY the endpoint 404s, so an unconfigured deploy never
# exposes an anonymous full-resync trigger. Keep private (Vercel project env vars).
CRON_SECRET=

# --- Vercel Blob (only when MEDIA_STORE=blob) ---------------------------------
# The store's read-write token, from the Blob store's page in the Vercel dashboard.
# The store id is read out of it, so the public URL of every file is derivable
# offline — no API call per rendered image. Also signs the short-lived tokens the
# admin hands the browser for direct uploads. Keep private.
BLOB_READ_WRITE_TOKEN=

# Absolute path to an ffmpeg binary. Normally unset: a system ffmpeg is used when
# there is one, otherwise the static build shipped by the imageio-ffmpeg wheel.
FFMPEG_BINARY=

# --- CDN cache (Vercel) -------------------------------------------------------
# The public pages are cached on Vercel's CDN, which is what keeps a visit from
# reaching Postgres at all. Purging is what makes a long TTL safe: whenever a product
# or an editable text changes, the affected tags are invalidated. Without a token the
# purge is a no-op and the TTL below becomes the only freshness guarantee, so leave
# these unset in dev (nothing to purge) and set them in the Vercel project.
VERCEL_PURGE_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
#
# How long Vercel may serve a cached page (seconds), and for how long it may keep
# serving the stale one while it revalidates in the background.
PAGE_CACHE_TTL=86400
PAGE_CACHE_STALE=604800
#
# In-process caches, in seconds. Short on purpose: invalidation only reaches the
# instance that wrote, and a stale read here can end up cached on the CDN.
CATALOG_CACHE_TTL=300
CONTENT_CACHE_TTL=60
